{
  "files.associations": {
    "*.sql": "postgres"
  },
  "sqltools.connections": [
    {
      "name": "Shreeji Database (PostgreSQL / Supabase)",
      "dialect": "PostgreSQL",
      "connectString": "${env:DATABASE_URL}"
    }
  ],
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "markdownlint.config": {
    "default": true,
    "MD013": false,
    "MD033": false
  }
}
