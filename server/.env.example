# Server Port & Environment
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Client Web App URL (Temporary testing on GitHub Pages / permanent custom domain)
CLIENT_URL=https://founder-svg.github.io/Shreeji

# CORS Settings: Comma-separated list of allowed client origins (no wildcard with credentials!)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5000,https://founder-svg.github.io

# Security & Authentication
JWT_SECRET=replace_with_strong_random_jwt_secret_min_32_characters
JWT_EXPIRES_IN=24h

# Admin Credentials for Protected Endpoints
ADMIN_EMAIL=admin@shreeji.com
ADMIN_PASSWORD=Admin@Shreeji2026
ADMIN_NAME=Shreeji Administrator

# In-Memory Cache TTL (in seconds)
CACHE_TTL_SECONDS=60

# Database Configuration (PostgreSQL / Supabase)
# Leave empty for local development store, or provide your PostgreSQL / Supabase connection:
DATABASE_URL=
# Example Supabase pooled connection string:
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Cloud Storage Configuration (S3 / Cloudflare R2 / Supabase / Local)
# Options: "local", "s3", "r2", "supabase"
STORAGE_PROVIDER=local

# AWS S3 / Cloudflare R2 / MinIO Credentials
S3_REGION=auto
S3_BUCKET=shreeji-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=
