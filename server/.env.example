# Server Port & Environment
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# CORS Settings (comma-separated or * for all in dev)
CORS_ORIGIN=*

# In-Memory Cache TTL (in seconds)
CACHE_TTL_SECONDS=60

# Database Configuration (PostgreSQL / Supabase)
# If empty, automatically runs on high-performance local memory/json store
DATABASE_URL=
# Example Supabase direct or pooled string:
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Cloud Storage Configuration (S3 / Cloudflare R2 / Supabase / Local)
# Options: "local", "s3", "r2", "supabase"
STORAGE_PROVIDER=local

# AWS S3 / Cloudflare R2 / MinIO Credentials (when STORAGE_PROVIDER is s3, r2, or supabase)
S3_REGION=auto
S3_BUCKET=shreeji-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# For Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
# For Supabase Storage S3-compatible: https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=
# Public CDN URL prefix for media assets (e.g. https://pub-xxx.r2.dev or https://bucket.s3.amazonaws.com)
S3_PUBLIC_URL=
