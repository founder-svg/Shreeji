{
  "name": "shreeji-server",
  "version": "1.0.0",
  "description": "High-performance, ultra-responsive backend server for Shreeji with PostgreSQL/Supabase and Cloud Storage (S3/R2/Local)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node tests/performance.test.js",
    "prod:start": "pm2 start ecosystem.config.cjs --env production",
    "prod:stop": "pm2 stop ecosystem.config.cjs",
    "prod:restart": "pm2 reload ecosystem.config.cjs",
    "prod:logs": "pm2 logs shreeji-server",
    "prod:status": "pm2 status"
  },
  "keywords": [
    "shreeji",
    "ecommerce",
    "fast-server",
    "high-performance",
    "express",
    "supabase",
    "postgresql",
    "s3",
    "cloudflare-r2"
  ],
  "author": "Shreeji Team",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "lru-cache": "^11.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "pm2": "^7.0.4"
  }
}
